<?xml version="1.0"?>
<ruleset name="ODSI Social Learning Platform">
	<description>WordPress Coding Standards for the ODSI plugins.</description>

	<file>plugins/odsi-lms</file>
	<file>plugins/odsi-social</file>
	<file>plugins/odsi-bridge</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/build/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>
	<arg name="cache" value=".phpcs-cache"/>

	<!-- Minimum supported versions, so the compatibility and WP sniffs fire correctly. -->
	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- We use PSR-4 class files, not WordPress's class-*.php naming. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Short array syntax and short ternaries are fine on PHP 8.1+. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!-- Yoda conditions add nothing with strict types and modern PHP. -->
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Docblock tags on promoted constructor properties are redundant. -->
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_odsi_lms"/>
				<element value="view_odsi_lms_reports"/>
				<element value="manage_odsi_social"/>
				<element value="edit_odsi_course"/>
				<element value="edit_odsi_courses"/>
				<element value="edit_others_odsi_courses"/>
				<element value="edit_odsi_lessons"/>
				<element value="edit_odsi_quizzes"/>
				<element value="edit_odsi_questions"/>
				<element value="edit_odsi_social_groups"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="odsi-lms"/>
				<element value="odsi-social"/>
				<element value="odsi-bridge"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="odsi"/>
				<element value="ODSI"/>
			</property>
		</properties>
		<!-- Templates receive scoped variables from the loader; they are not globals. -->
		<exclude-pattern>*/templates/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- Tests: relax the rules that only make sense for shipped code. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Arrays.DuplicateArrayKey">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Formatting.MultipleStatementAlignment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
