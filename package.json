{
	"name": "odsi-slp",
	"version": "0.1.0",
	"private": true,
	"description": "Development toolchain for the ODSI social learning platform monorepo.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env clean all && wp-env start",
		"env:cli": "wp-env run cli wp",
		"lint": "npm run lint:php && npm run lint:js",
		"lint:php": "composer lint",
		"lint:js": "eslint plugins/*/assets/js plugins/*/assets/src tests/e2e --ext .js,.jsx,.ts,.tsx",
		"analyse": "composer analyse",
		"check:boundaries": "bash bin/check-plugin-boundaries.sh",
		"test": "npm run check:boundaries && composer test && npm run test:e2e",
		"test:unit": "composer test:unit",
		"test:integration": "composer test:integration",
		"test:e2e": "playwright test -c tests/e2e/playwright.config.js",
		"test:e2e:local": "ODSI_E2E_BASE_URL=http://127.0.0.1:8080 playwright test -c tests/e2e/playwright.config.js",
		"serve:local": "bash bin/serve-local.sh",
		"build": "wp-scripts build --webpack-src-dir=plugins/odsi-lms/assets/src --output-path=plugins/odsi-lms/assets/build",
		"start": "wp-scripts start --webpack-src-dir=plugins/odsi-lms/assets/src --output-path=plugins/odsi-lms/assets/build"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/eslint-plugin": "^21.0.0",
		"@wordpress/scripts": "^30.0.0",
		"eslint": "^8.57.0"
	}
}
