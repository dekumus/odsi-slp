<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit suite: no WordPress, no database. Brain Monkey stubs the WordPress
  functions the classes under test call. Runs in seconds; run it constantly.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/unit/bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.unit.result.cache"
         beStrictAboutTestsThatDoNotTestAnything="true"
         beStrictAboutOutputDuringTests="true"
         failOnWarning="true"
         failOnRisky="true"
         convertDeprecationsToExceptions="false">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">tests/unit</directory>
    </testsuite>
  </testsuites>
  <coverage>
    <include>
      <directory suffix=".php">plugins/odsi-lms/src</directory>
      <directory suffix=".php">plugins/odsi-social/src</directory>
      <directory suffix=".php">plugins/odsi-bridge/src</directory>
    </include>
  </coverage>
</phpunit>
